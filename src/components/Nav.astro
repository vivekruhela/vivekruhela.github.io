---
import { site as loadSite } from '../lib/content';
const site = loadSite();
---
<nav class="top"><div class="wrap">
  <a class="brand" href="/">{site.name}</a>
  <div class="links"><a href="/#journey">Journey</a><a href="/#work">Work</a><a href="/#thinking">Thinking</a><a href="/#next">Ambitions</a><a href="/blog/">Notebook</a><a href="/#contact">Contact</a></div>
  <div class="spacer"></div>
  {site.beta && <span class="pill">Private beta</span>}
  <button class="kbtn" id="openPal" type="button" aria-label="Search the site">Search <kbd>⌘K</kbd></button>
</div></nav>

<div class="pal-bg" id="palBg" hidden>
  <div class="pal" role="dialog" aria-modal="true" aria-label="Search">
    <input id="palIn" type="text" placeholder="Search papers, patents, posts, chapters…" autocomplete="off" aria-label="Search" />
    <ul id="palList"></ul>
  </div>
</div>
<script src="../scripts/palette.js"></script>
